    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max_old_space_size=7680 vite dev --host 127.0.0.1 --port 5173 --strictPort",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=7680 vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --plugin-search-dir=. . && eslint --ignore-path .gitignore .",
    "format": "prettier --write --plugin-search-dir=. .",
    "growth:new": "node scripts/new-growth-node.mjs",
    "growth:backfill": "node scripts/backfill-growth-pages.mjs",
    "growth:page": "node scripts/create-growth-page.mjs",
    "post:new": "node scripts/new-post.mjs",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_DEV=1 playwright test",
    "test:e2e:install": "playwright install chromium firefox",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "test:perf:preview": "E2E_PERF_PREVIEW=1 playwright test -c playwright.perf.config.ts",
    "verify:assets": "node scripts/verify-assets.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "vitest run"
  },
