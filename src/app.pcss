@font-face {
  font-family: 'pokemondppt';
  src: url('/src/styles/fonts/pokemondppt.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
}

@font-face {
  font-family: 'Pokemon GB';
  src: url('styles/fonts/PokemonGB.woff') format('woff');
  src: url('styles/fonts/PokemonGB.ttf') format('truetype');
}

@font-face {
  font-family: 'Press Start 2P';
  src: url('styles/fonts/PressStart2P-Regular.woff') format('woff');
  src: url('styles/fonts/PressStart2P-Regular.ttf') format('truetype');
}

@tailwind base;

@tailwind components;

@tailwind utilities;

*,
*::before,
*::after {
  box-sizing: border-box;
}

:root {
  --pointer: url('/assets/fatpika-cursor.png'), pointer;
}

html,
* {
  cursor: url('/assets/fatpika-cursor.png'), auto;
}

a, button, [role="button"], input[type="submit"], input[type="button"] {
  cursor: var(--pointer);
}

/*
 * The older editorial pages (and anything not yet ported) read these names; they now point at the
 * Sampler tokens in styles/sampler.css so every page follows ivory / ink.
 */
:root {
  --site-bg: var(--bg);
  --site-bg-image: none;
  --site-panel: var(--panel);
  --site-panel-2: var(--panel);
  --site-line: var(--rule);
  --site-line-strong: color-mix(in srgb, var(--fg) 18%, transparent);
  --site-fg: var(--fg);
  --site-fg-2: var(--fg2);
  --site-muted: var(--muted);
  --site-dim: var(--muted);
  --site-accent: var(--c1);
  --site-accent-ink: var(--bg);
  --site-mono: var(--mono);
  --site-mono2: var(--mono);
  --site-sans: var(--serif);
}

.site-editorial-page {
  min-height: 100vh;
  color: var(--site-fg);
}

.ds-wrap {
  max-width: 1180px;
  margin-inline: auto;
  padding-inline: clamp(20px, 5vw, 84px);
}

.ds-card {
  border: 1px solid var(--site-line);
  background: color-mix(in srgb, var(--site-panel) 78%, transparent);
  color: var(--site-fg);
  box-shadow: none;
}

.ds-card:hover {
  border-color: color-mix(in srgb, var(--site-accent) 45%, transparent);
}

.ds-panel {
  border: 1px solid var(--site-line);
  background: color-mix(in srgb, var(--site-panel-2) 82%, transparent);
  color: var(--site-fg);
}

.ds-muted {
  color: var(--site-muted);
}

.ds-link {
  color: var(--site-muted);
  transition: color 0.15s, border-color 0.15s, opacity 0.15s;
}

.ds-link:hover {
  color: var(--site-accent);
}

.ds-btn {
  border-color: var(--site-accent);
  background: var(--site-accent);
  color: var(--site-accent-ink);
}

/* Fullscreen slide deck (?mode=slides + slides: true) */
body.deck-presentation-active {
  overflow: hidden;
}
html:has(body.deck-presentation-active) {
  overflow: hidden;
}
body.deck-presentation-active :is(header.site, footer.site, .vine, .read-thread) {
  display: none !important;
}
body.deck-presentation-active .deck-presentation-shell {
  min-height: 100dvh;
}

/* Route changes: View Transitions (Chrome/Edge/Safari); others get the fade in transition.svelte */
@media (prefers-reduced-motion: no-preference) {
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.22s;
    animation-timing-function: ease-in-out;
  }
}

/* Modal/lightbox overlays: solid dim by default; blur only when compositor-friendly */
.overlay-dim--light {
  background-color: rgb(0 0 0 / 0.5);
}

.overlay-dim--heavy {
  background-color: rgb(0 0 0 / 0.9);
}

@supports (backdrop-filter: blur(4px)) {
  @media (prefers-reduced-motion: no-preference) {
    .overlay-dim--light {
      backdrop-filter: blur(4px);
    }

    .overlay-dim--heavy {
      backdrop-filter: blur(6px);
    }
  }
}
